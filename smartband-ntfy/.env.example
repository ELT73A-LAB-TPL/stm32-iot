# .env — variáveis de ambiente da stack smartband
# Copie este arquivo para .env e ajuste os valores antes de subir

# ─── Node-RED ─────────────────────────────────────────────
# Chave usada para criptografar credenciais salvas no fluxo
NODE_RED_SECRET=troque_por_uma_chave_segura_aqui

# ─── Ntfy ─────────────────────────────────────────────────
# URL base acessível pelo app Flutter e pelo Node-RED
# Em rede local: IP da Raspberry Pi ou nome mDNS
NTFY_BASE_URL=http://192.168.1.100:8080

# ─── Timezone ─────────────────────────────────────────────
TZ=America/Sao_Paulo
