\ntemp = Number(temp.toFixed(2));\n\n// Prepare the SQL query statement\nmsg.topic = `INSERT INTO sensor_data (ADC1IN1, voltage1, BLUELED, TEMPSENSOR, v_ref, v_sense, temp, VREFINT)\n             VALUES (${ADC1IN1}, ${voltage1}, ${BLUELED}, ${TEMPSENSOR}, ${v_ref}, ${v_sense}, ${temp}, ${VREFINT});`;\n\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":660,"y":380,"wires":[["f904b34b467ad5ee"]]},{"id":"ad84632070edba25","type":"template","z":"c1248a4f3ab49a1e","name":"Create sensor_data table","field":"topic","fieldType":"msg","format":"sql","syntax":"mustache","template":"CREATE TABLE IF NOT EXISTS sensor_data (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,\n    ADC1IN1 INTEGER,    \n    BLUELED INTEGER,\n    TEMPSENSOR INTEGER,\n    VREFINT INTEGER,\n    voltage1 REAL,\n    v_ref REAL,\n    v_sense REAL,\n    temp REAL    \n);","output":"str","x":650,"y":460,"wires":[["f904b34b467ad5ee"]]},{"id":"fac12e41afb99e7b","type":"inject","z":"c1248a4f3ab49a1e","name":"","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":400,"y":460,"wires":[["ad84632070edba25"]]},{"id":"f904b34b467ad5ee","type":"sqlite","z":"c1248a4f3ab49a1e","mydb":"95be1cdf72319762","sqlquery":"msg.topic","sql":"","name":"mcu_mock_data.sqlite","x":1040,"y":460,"wires":[["0fa3a9a349230f53"]]},{"id":"3d6d0374f2cdef90","type":"function","z":"c1248a4f3ab49a1e","name":"Generate mock data","func":"// Generate mock data\nlet ADC1IN1 = Math.floor(Math.random() * 4096);\nlet BLUELED = Math.round(Math.random());\nlet TEMPSENSOR = Math.floor(Math.random() * 1000) + 500; \nlet VREFINT = Math.floor(Math.random() * 1000) + 1000; \n\n// Prepare the SQL query statement\nmsg.topic = `INSERT INTO sensor_data (ADC1IN1,BLUELED, TEMPSENSOR, VREFINT)\n             VALUES (${ADC1IN1}, ${BLUELED}, ${TEMPSENSOR}, ${VREFINT});`;\n\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":660,"y":320,"wires":[["f904b34b467ad5ee"]]},{"id":"025a5484fca66168","type":"inject","z":"c1248a4f3ab49a1e","name":"4 variables","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":420,"y":320,"wires":[["3d6d0374f2cdef90"]]},{"id":"b381907d2473440c","type":"inject","z":"c1248a4f3ab49a1e","name":"Clear data","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"DELETE FROM sensor_data;","payload":"","payloadType":"date","x":680,"y":520,"wires":[["f904b34b467ad5ee"]]},{"id":"0ae9cdc4ceb4b10a","type":"template","z":"c1248a4f3ab49a1e","name":"Delete the table structure and all data","field":"topic","fieldType":"msg","format":"sql","syntax":"mustache","template":"DROP TABLE IF EXISTS sensor_data;","output":"str","x":650,"y":580,"wires":[["f904b34b467ad5ee"]]},{"id":"a53b42dab20104b8","type":"inject","z":"c1248a4f3ab49a1e","name":"","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":380,"y":580,"wires":[["0ae9cdc4ceb4b10a"]]},{"id":"9b6361484b659998","type":"template","z":"c1248a4f3ab49a1e","name":"UPDATE sensor_data tmp","field":"topic","fieldType":"msg","format":"sql","syntax":"mustache","template":"UPDATE sensor_data\nSET temp = ROUND(((((TEMPSENSOR * 1.21 / VREFINT) - 0.76) * 1000.0 / 2.5) + 25.0), 2)\nWHERE temp IS NULL;","output":"str","x":660,"y":740,"wires":[["f904b34b467ad5ee"]]},{"id":"206b0950ace718c3","type":"inject","z":"c1248a4f3ab49a1e","name":"","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":380,"y":740,"wires":[["9b6361484b659998"]]},{"id":"7d16a18ad1d21c0a","type":"template","z":"c1248a4f3ab49a1e","name":"Clear sensor_data tmp data","field":"topic","fieldType":"msg","format":"sql","syntax":"mustache","template":"UPDATE sensor_data SET temp = NULL;","output":"str","x":660,"y":660,"wires":[["f904b34b467ad5ee"]]},{"id":"3b73535d62b43c98","type":"inject","z":"c1248a4f3ab49a1e","name":"","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":380,"y":660,"wires":[["7d16a18ad1d21c0a"]]},{"id":"2d82edb981709e62","type":"function","z":"c1248a4f3ab49a1e","name":"JSON mcu_mock_data","func":"// 1. Define typical STM32 Internal Sensor calibration constants\nconst V_AT_25C = 0.76;      // Volts at 25°C\nconst AVG_SLOPE = 0.0025;   // 2.5 mV/°C converted to Volts/°C\n\n// 2. Generate highly realistic MCU Mock Data (Assuming 12-bit ADC: 0-4095)\nlet ADC1IN1 = Math.floor(Math.random() * (2600 - 1500) + 1500); \nlet BLUELED = Math.round(Math.random());                        \nlet VREFINT = Math.floor(Math.random() * (1700 - 1600) + 1600); \n\n// Dynamically calculate actual operational VDDA (v_ref) based on the VREFINT reading\nlet v_ref = (1.21 * 4095) / VREFINT; \n\n// Calculate actual analog voltage on target pin\nlet voltage1 = (ADC1IN1 * v_ref) / 4095;\n\n// Internal temperature sensor raw ADC reading typically scales between 900-1100\nlet TEMPSENSOR = Math.floor(Math.random() * (1100 - 950) + 950); \nlet v_sense = (TEMPSENSOR * v_ref) / 4095;\n\n// Linear formula to extract actual Celsius degrees from analog sensor voltage step\nlet temp = ((v_sense - V_AT_25C) / AVG_SLOPE) + 25.0; \n\n// 3. Format floats and build the clean JSON payload object\nmsg.payload = {\n    \"ADC1IN1\": ADC1IN1,\n    \"voltage1\": Number(voltage1.toFixed(4)),\n    \"BLUELED\": BLUELED,\n    \"TEMPSENSOR\": TEMPSENSOR,\n    \"v_ref\": Number(v_ref.toFixed(4)),\n    \"v_sense\": Number(v_sense.toFixed(4)),\n    \"temp\": Number(temp.toFixed(2)),\n    \"VREFINT\": VREFINT\n};\n\n// Set a descriptive topic for your telemetry stream\nmsg.topic = \"telemetry/mcu_mock_data\";\n\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":690,"y":220,"wires":[["f6e20887d8f7cd8c"]]},{"id":"98ad482b4aa4c00a","type":"inject","z":"c1248a4f3ab49a1e","name":"8 Vars","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":410,"y":220,"wires":[["2d82edb981709e62"]]},{"id":"a4c9de3a5b911127","type":"function","z":"c1248a4f3ab49a1e","name":"JSON mcu_mock_data","func":"// Generate highly realistic MCU Mock Data (Assuming 12-bit ADC: 0-4095)\nlet ADC1IN1 = Math.floor(Math.random() * (2600 - 1500) + 1500); \nlet BLUELED = Math.round(Math.random());                        \nlet VREFINT = Math.floor(Math.random() * (1700 - 1600) + 1600); \n\n// Internal temperature sensor raw ADC reading typically scales between 900-1100\nlet TEMPSENSOR = Math.floor(Math.random() * (1100 - 950) + 950); \n\n// Format floats and build the clean JSON payload object\nmsg.payload = {\n    \"ADC1IN1\": ADC1IN1,\n    \"BLUELED\": BLUELED,\n    \"TEMPSENSOR\": TEMPSENSOR,\n    \"VREFINT\": VREFINT\n};\n\n// Set a descriptive topic for your telemetry stream\nmsg.topic = \"telemetry/mcu_mock_data\";\n\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":690,"y":160,"wires":[["f6e20887d8f7cd8c"]]},{"id":"202b8ec9b5ae7e5d","type":"inject","z":"c1248a4f3ab49a1e","name":"4 Vars","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":410,"y":160,"wires":[["a4c9de3a5b911127"]]},{"id":"f6e20887d8f7cd8c","type":"mqtt out","z":"c1248a4f3ab49a1e","name":"","topic":"telemetry/mcu_mock_data","qos":"","retain":"","respTopic":"","contentType":"","userProps":"","correl":"","expiry":"","broker":"9b22c48598f40342","x":1020,"y":160,"wires":[]},{"id":"6e2a798a1e572ac9","typ